        "partitions": [
          {
            "name": "vw_fact_delitos",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = PostgreSQL.Database(Servidor, BaseDatos),",
                "    Vista = Origen{[Schema=\"public\",Item=\"vw_fact_delitos\"]}[Data]",
                "in",
                "    Vista"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total delitos",
            "expression": "COUNTROWS ( vw_fact_delitos )",
            "lineageTag": "3c627fa1-df1b-5d7e-912a-0998ede88afc",
            "formatString": "#,0"
          },
          {
            "name": "Total año anterior",
            "expression": "CALCULATE ( [Total delitos], SAMEPERIODLASTYEAR ( vw_dim_tiempo[fecha] ) )",
            "lineageTag": "84152e6c-c8bf-5620-9207-bbd267167fb5",
            "formatString": "#,0"
          },
          {
            "name": "Variación % anual",
            "expression": "DIVIDE ( [Total delitos] - [Total año anterior], [Total año anterior] )",
            "lineageTag": "4eb4e7a6-78d3-5107-bd70-dd307f54ff4c",
            "formatString": "0.0 %;-0.0 %;0.0 %"
          },
          {
            "name": "% hurto",
            "expression": "DIVIDE (\n    CALCULATE ( [Total delitos], vw_dim_conducta[grupo_delito] = \"HURTO\" ),\n    CALCULATE ( [Total delitos], REMOVEFILTERS ( vw_dim_conducta ) )\n)",
            "lineageTag": "692ab367-6b64-5028-89c4-b0b688846920",
            "formatString": "0.0 %;-0.0 %;0.0 %"
          },
          {
            "name": "% SIN DATO (género)",
            "expression": "DIVIDE (\n    CALCULATE ( [Total delitos], vw_dim_victima[genero] = \"SIN DATO\" ),\n    CALCULATE ( [Total delitos], REMOVEFILTERS ( vw_dim_victima[genero] ) )\n)",
            "lineageTag": "f2a9d184-e84d-5de7-8af0-d23c603c8868",
            "formatString": "0.0 %;-0.0 %;0.0 %"
          },
          {
            "name": "Comuna con más casos",
            "expression": "VAR t = ADDCOLUMNS ( VALUES ( vw_dim_territorio[comuna] ), \"@n\", [Total delitos] )\nRETURN MAXX ( TOPN ( 1, t, [@n], DESC ), vw_dim_territorio[comuna] )",
            "lineageTag": "479ed822-4267-58b8-b2f0-5fbad4ba4382"
          },
          {
            "name": "Participación comuna con más casos",
            "expression": "VAR t = ADDCOLUMNS ( VALUES ( vw_dim_territorio[comuna] ), \"@n\", [Total delitos] )\nRETURN DIVIDE ( MAXX ( t, [@n] ), [Total delitos] )",
            "lineageTag": "2cdd9092-4dbd-5e20-aa9e-a70de77fca2b",
            "formatString": "0.0 %;-0.0 %;0.0 %"
          },
          {
            "name": "Promedio diario",
            "expression": "DIVIDE ( [Total delitos], COUNTROWS ( vw_dim_tiempo ) )",
            "lineageTag": "420aa38d-d506-5ce2-8733-eb12800083f1",
            "formatString": "#,0.0"
          }
        ]
      },
